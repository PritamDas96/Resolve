# ============================================================================
# RESOLVE — environment variable template.
#
# Copy this file to `.env` and fill in the values. NEVER put real secret values
# in this file; it is committed to git. The real `.env` is git-ignored.
# ============================================================================

# --- LLM inference (via LiteLLM) --------------------------------------------
# Google AI Studio key (https://aistudio.google.com) — router + drafter.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Groq key "gsk_..." (https://groq.com) — used as the JUDGE (different model
# family from the generator; see docs/adr/013-free-tier-providers.md).
GROQ_API_KEY=

# --- Model routing (model IDs, not secrets) ---------------------------------
ROUTER_MODEL=gemini/gemini-3.8-flash
DRAFTER_MODEL=gemini/gemini-3.8-flash
JUDGE_MODEL=groq/openai/gpt-oss-120b

# --- Observability ----------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=resolve
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Hugging Face (optional) ------------------------------------------------
HF_TOKEN=

# --- Local services (no keys; started via Docker in later phases) -----------
POSTGRES_DSN=postgresql://resolve:resolve@localhost:5432/resolve
QDRANT_URL=http://localhost:6333
